    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "crawl:skills": "tsx scripts/crawl-skills.ts",
    "crawl:trending": "tsx scripts/crawl-trending.ts",
    "db:apply": "node scripts/apply-migration.mjs",
    "cursor:fetch": "node scripts/fetch-cursor-sprites.mjs && node scripts/fetch-cursor-posters.mjs"
  },
  "dependencies": {
