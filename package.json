    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@tiptap/extension-character-count": "3.31.4",
    "@tiptap/extension-code-block-lowlight": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-link": "3.31.4",
    "@tiptap/extension-placeholder": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/suggestion": "3.31.4",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.9.0",
    "dayjs": "^1.11.20",
    "dotenv": "^17.4.2",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.475.0",
    "marked": "^18.0.4",
    "next": "^16.4.0",
    "next-auth": "^4.24.15",
    "parse5": "^8.0.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.8.1",
    "resend": "^6.12.0",
    "three": "^0.184.0",
    "zustand": "^5.0.13"
