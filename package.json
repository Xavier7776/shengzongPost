  "devDependencies": {
    "@dietrichgebert/ponytail": "^4.9.0",
    "@electric-sql/pglite": "^0.5.8",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.0.1",
